# Names only. Copy to /home/user/.aircheck/publisher.env (chmod 600) and fill in on the VM.
CONVEX_URL=
# Must match PUBLISHER_TOKEN in the Convex deployment; at least 32 characters.
PUBLISHER_TOKEN=
# The console's public address; the Telegram card links to <APP_URL>/packages/<id>.
APP_URL=
# Optional; default /home/user/.aircheck/mixcloud/token.json (written by the console's Connect Mixcloud).
MIXCLOUD_TOKEN_FILE=
# Optional; default /home/user/aircheck-audio/prepared (the media service's MP3s).
PREPARED_DIR=
# Optional; default /home/user/.aircheck/publisher-state.json
STATE_FILE=
# Optional; default /home/user/.airc/secrets.env (TELEGRAM_BOT_TOKEN and TELEGRAM_ALLOWED_IDS are read from it).
AIRC_SECRETS_FILE=
# Optional; default 30000 (milliseconds between publish passes)
POLL_MS=
