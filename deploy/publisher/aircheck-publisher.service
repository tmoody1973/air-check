# Air Check publisher: the only program that uploads to Mixcloud. Uploads human-approved packages (at most 3 per
# America/Chicago day, oldest first), never retries an upload whose outcome is unknown, and sends Telegram
# "ready to review" cards (a link only). Runs on the host, like the relay and media.
# Install: sudo cp to /etc/systemd/system/ && sudo systemctl enable --now aircheck-publisher
# The unlisted test (Task 7): stop this service, then run node dist/main.js --unlisted-test <packageId> as user.
[Unit]
Description=Air Check: Mixcloud publisher
After=network-online.target
Wants=network-online.target

[Service]
User=user
EnvironmentFile=/home/user/.aircheck/publisher.env
Environment=PATH=/home/user/.nvm/versions/node/v22.23.4/bin:/usr/bin:/bin
WorkingDirectory=/home/user/aircheck-publisher
ExecStart=/home/user/.nvm/versions/node/v22.23.4/bin/node /home/user/aircheck-publisher/dist/main.js
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
ProtectSystem=strict
# Read-only: the prepared MP3s (/home/user/aircheck-audio/prepared), the Mixcloud token file and ~/.airc/secrets.env.
ProtectHome=read-only
# Write: only the state file's folder (sent card ids, the hash of a refused key), written by atomic rename.
ReadWritePaths=/home/user/.aircheck
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
