# Names only. Copy to /home/user/.aircheck/ingest.env (chmod 600) and fill in on the VM. Never commit values.
CONVEX_URL=
# Must match INGEST_TOKEN in the Convex deployment: 48 hex characters, different from every other service's token.
INGEST_TOKEN=
# Box server app (Client Credentials Grant, App Access Only, read-only). The folder id is the Full Episodes folder.
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_ENTERPRISE_ID=
BOX_FOLDER_ID=
# The same Google OAuth client and Dropbox app as the console's Connect buttons (to refresh their access tokens).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# Optional; default /home/user/.aircheck/ingest-tokens (google.json and dropbox.json, written by the console).
INGEST_TOKEN_DIR=
# Optional; default /home/user/aircheck-audio/inbox (the media service's inbox; one YYYY-MM-DD folder per show).
INBOX_DIR=
# Optional; default /home/user/aircheck-audio/prepared (the media service's MP3s; counted, never written).
PREPARED_DIR=
# Optional; default 3600000 (milliseconds between scans) and 60000 (between fetch + draft passes).
SCAN_MS=
POLL_MS=
