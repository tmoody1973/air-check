# Names only. Copy to /home/user/.aircheck/relay.env (chmod 600) and fill in on the VM.
CONVEX_URL=
# Must match RELAY_TOKEN in the Convex deployment; at least 32 characters.
RELAY_TOKEN=
# Gateway tokens come from: nemohermes <name> gateway-token --quiet
# Leave one empty to skip that sandbox.
AIRC_GATEWAY_TOKEN=
AIRCDEMO_GATEWAY_TOKEN=
# Optional; default /home/user/.local/bin/nemohermes
NEMOHERMES_BIN=
# Oct 29 prefetch (optional): the relay tells the bridge a research run is starting, so its first web searches run
# without the model. Same tokens as in ~/aircheck-bridge's bridge.env. Leave BRIDGE_URL empty to skip (the agent's
# first first_search call starts them instead).
BRIDGE_URL=https://10.104.0.41:8443
AIRCHECK_MCP_TOKEN=
AIRCHECK_DEMO_MCP_TOKEN=
# The bridge's certificate is signed by Air Check's own CA; Node reads this when the relay starts.
NODE_EXTRA_CA_CERTS=/home/user/.aircheck/ca/ca.crt
