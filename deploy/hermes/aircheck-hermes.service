# Starts the Hermes sandbox at boot. The OpenShell gateway it needs is a
# systemd *user* service, which only runs at boot because linger is enabled
# (`sudo loginctl enable-linger user`, see docs/DEPLOY.md).
# Install: sudo cp to /etc/systemd/system/ && sudo systemctl enable aircheck-hermes
[Unit]
Description=Air Check: start the Hermes sandbox (NemoClaw)
After=docker.service network-online.target user@1001.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=user
Environment=PATH=/home/user/.local/bin:/home/user/.nvm/versions/node/v22.23.4/bin:/usr/bin:/bin
Environment=XDG_RUNTIME_DIR=/run/user/1001
# `start` brings the sandbox to Ready but (OpenShell 0.0.116) does not restore the
# host port forward for :8642, so `recover` runs next; it is a no-op when healthy.
# Hermes inside the sandbox needs a while after a cold boot, so retry recover
# every 15 s for up to 5 minutes.
# The leading `-` makes a give-up non-fatal on purpose: if this ExecStart exits non-zero the unit is
# marked failed, and systemd then skips ExecStop at shutdown, so Docker kills the sandbox first and it
# lands in phase Error. The watchdog alerts if Hermes is really down.
ExecStart=-/home/user/.local/bin/nemohermes airc start
ExecStart=-/bin/bash -c 'for i in $(seq 1 20); do /home/user/.local/bin/nemohermes airc recover && exit 0; sleep 15; done; echo "aircheck-hermes: Hermes not healthy after 5 min; watchdog will alert"; exit 1'
# At shutdown, stop the sandbox through OpenShell while the gateway (user@1001)
# and Docker are still up. If Docker kills the container first, the gateway
# records an unexpected exit and the sandbox lands in phase Error, which
# neither `start` nor `rebuild` can leave (docs/FRICTION_LOG.md, 2026-10-27).
# ExecStopPost, not ExecStop: systemd skips ExecStop when a shutdown interrupts the
# start loop above or the start times out; ExecStopPost runs in every case. The `-`
# makes it harmless when the sandbox is already stopped.
ExecStopPost=-/home/user/.local/bin/openshell sandbox stop airc
TimeoutStartSec=900
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
