# No `log` directive on purpose: /sign-in?__clerk_ticket=... carries a one-time
# sign-in token and must never land on disk. Caddy writes no access log.
aircheck.rhythmlabradio.com {
	reverse_proxy console:3000 {
		# header_up with a value replaces whatever the client sent; /demo trusts only this header.
		header_up X-Real-IP {remote_host}
	}
}
