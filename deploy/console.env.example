# Copy to ~/.aircheck/console.env on the VM (chmod 600). Names only; never commit values.
# NEXT_PUBLIC_* are baked into the image at build time (compose build args read them from this file).
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Bare origin, e.g. https://aircheck.rhythmlabradio.com (no path, no trailing slash needed).
NEXT_PUBLIC_APP_URL=
CLERK_SECRET_KEY=
AIRCHECK_DEMO_USER_ID=
# Hard Rule 8: no telemetry.
NEXT_TELEMETRY_DISABLED=1
CLERK_TELEMETRY_DISABLED=1
# Mixcloud app (Connect Mixcloud in Settings). Server-only; the redirect URI is NEXT_PUBLIC_APP_URL + /api/mixcloud/callback.
MIXCLOUD_CLIENT_ID=
# The app's secret. Never logged; only sent to Mixcloud's token endpoint.
MIXCLOUD_CLIENT_SECRET=
# Where the token is written inside the container. Empty means /mixcloud/token.json (the compose mount).
MIXCLOUD_TOKEN_FILE=
# Google Drive and Dropbox apps (Connect Google Drive / Connect Dropbox in Settings), read-only. Server-only; redirect
# URIs are NEXT_PUBLIC_APP_URL + /api/google/callback and /api/dropbox/callback. Secrets never logged; each is sent
# only to its provider's token endpoint. The ingest service reads the same four names from its own env file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# Where google.json and dropbox.json (refresh token only) are written inside the container. Empty means /ingest-tokens.
INGEST_TOKEN_DIR=
# AUDIO_DIR is left unset: the console reads prepared MP3s from /audio (the read-only compose mount).
