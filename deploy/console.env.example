# Copy to ~/.aircheck/console.env on the VM (chmod 600). Names only; never commit values.
# NEXT_PUBLIC_* are baked into the image at build time (compose build args read them from this file).
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Bare origin, e.g. https://aircheck.rhythmlabradio.com (no path, no trailing slash needed).
NEXT_PUBLIC_APP_URL=
CLERK_SECRET_KEY=
AIRCHECK_DEMO_USER_ID=
# Hard Rule 8: no telemetry.
NEXT_TELEMETRY_DISABLED=1
CLERK_TELEMETRY_DISABLED=1
