# Names only. Copy to /home/user/.aircheck/media.env (chmod 600) and fill in on the VM.
CONVEX_URL=
# Must match MEDIA_TOKEN in the Convex deployment; at least 32 characters.
MEDIA_TOKEN=
# Where the show's two hour WAVs arrive, in one YYYY-MM-DD folder per show.
INBOX_DIR=
# Where the joined MP3s go; the console container reads from here.
PREPARED_DIR=
# Optional; default 30000 (milliseconds between scans)
POLL_MS=
