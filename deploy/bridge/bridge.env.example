# ~/.aircheck/bridge.env on the VM (mode 600). Names only; never commit values.
# Each token: 48 random hex chars (openssl rand -hex 24), all three different.
BRIDGE_HOST=10.104.0.41
BRIDGE_PORT=8443
TLS_CERT=/home/user/.aircheck/bridge/tls.crt
TLS_KEY=/home/user/.aircheck/bridge/tls.key
CRATE_DIR=/home/user/crate-cli
# Registered with NemoClaw: `nemohermes airc mcp add crate ... --env CRATE_MCP_TOKEN`
CRATE_MCP_TOKEN=
# Registered with NemoClaw: `nemohermes airc mcp add aircheck ... --env AIRCHECK_MCP_TOKEN`
AIRCHECK_MCP_TOKEN=
# Convex HTTP actions origin (https://<deployment>.convex.site), bare origin
CONVEX_SITE_URL=
# Same value as the Convex env var AGENT_SUBMIT_TOKEN on that deployment
AGENT_SUBMIT_TOKEN=
