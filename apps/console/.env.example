# Copy to .env.local and fill in. Secrets live only in .env.local (git-ignored).
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=
AIRCHECK_DEMO_USER_ID=
# Production origin, a bare origin, e.g. https://aircheck.rhythmlabradio.com (no path). Build-time; leave empty in dev/CI.
NEXT_PUBLIC_APP_URL=
# Hard Rule 8: no telemetry.
NEXT_TELEMETRY_DISABLED=1
CLERK_TELEMETRY_DISABLED=1
